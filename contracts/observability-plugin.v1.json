{
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meridian.example/contracts/observability-plugin.v1.json",
  "title": "Meridian Observability Plugin V1 compatibility evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "package", "version", "plugin", "catalogs", "signals", "boundaries"],
  "properties": {
    "formatVersion": {"const": "meridian.observability.plugin.v1"},
    "package": {"const": "meridian-plugin-observability"},
    "version": {"const": "1.0.0"},
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "contract", "core"],
      "properties": {
        "id": {"const": "observability"},
        "contract": {"const": "1.0.0"},
        "core": {"const": "1.x"}
      }
    },
    "catalogs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owned", "used"],
      "properties": {
        "owned": {"const": []},
        "used": {"const": ["evidence"]}
      }
    },
    "signals": {
      "type": "array",
      "prefixItems": [
        {"const": "logs"},
        {"const": "metrics"},
        {"const": "traces"}
      ],
      "items": false
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collectorProvisioning", "engineSelection", "backendCredentials", "nativeQuery"],
      "properties": {
        "collectorProvisioning": {"const": false},
        "engineSelection": {"const": false},
        "backendCredentials": {"const": false},
        "nativeQuery": {"const": false}
      }
    }
  }
}
